{
  "name": "mind-bloom-backend",
  "version": "1.0.0",
  "main": "build/app.js",
  "scripts": {
    "start": "node build/app.js",
    "collect": "node build/collect.js",
    "analyze": "node build/analyze.js",
    "migrate": "knex migrate:latest --knexfile databases/knexfile.js",
    "build": "prisma generate && tsc && cp -r src/views src/public build/",
    "prisma:generate": "prisma generate",
    "clean": "rm -rf ./build",
    "dev": "npm run watch",
    "start:dev": "npm run dev",
    "watch": "nodemon src/app.ts",
    "test": "tsc --noEmit && vitest run"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-handlebars": "^8.0.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "openai": "^6.38.0",
    "pg": "^8.13.3",
    "prisma": "^6.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.11.11",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
